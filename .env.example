# AI Studio Cam — template configuration.
# Copy to `.env` (git-ignored) and edit. Every value is optional; commented
# entries show their defaults.
#
# Camera device path, numeric index, or stream URL.
# Default: /dev/video42 on Linux *only when that device exists*, otherwise 0.
# /dev/video42 is a v4l2loopback virtual device, so it only works while a producer
# (OBS, ffmpeg) is feeding it. Leave this unset to use the first real device.
AI_STUDIO_CAM_CAMERA_INDEX = "0"

# Optional. Only needed for the LLM chat fallback. Without it, chat answers from
# the recorded data deterministically (no network, no key required).
# Uncomment and paste a key from https://console.groq.com/keys to enable it.
# GROQ_API_KEY = "gsk_..."

# ── Optional overrides ────────────────────────────────────────────────────────
# Set to 1 to also try the numeric index when a /dev/video* path is configured.
# AI_STUDIO_CAM_INCLUDE_INDEX_FALLBACK = "0"
# Set to 1 to scan every /dev/video* device before giving up (Linux).
# AI_STUDIO_CAM_SCAN_ALL_DEVICES = "0"
# General YOLO checkpoint. Ultralytics downloads yolov8n.pt on first use.
# AI_STUDIO_GENERAL_YOLO_MODEL = "yolov8n.pt"
# Groq model used by the LLM chat fallback.
# GROQ_MODEL = "openai/gpt-oss-120b"
# Port for `python server.py`.
# PORT = "8000"

# ── Object detection inference ─────────────────────────────────────────────────
# Defaults come from the offline benchmark (`python main.py bench-detect`); see
# OBJECT_DETECTION_PLAN.md. Run that command after changing any of these.
# Inference size. Larger finds small/carried objects better and costs CPU time.
# AI_STUDIO_YOLO_IMGSZ = "768"
# Confidence threshold (0.01-0.99). Lower finds more, including low-confidence junk.
# AI_STUDIO_YOLO_CONF = "0.25"
# NMS IoU threshold (0.1-0.95).
# AI_STUDIO_YOLO_IOU = "0.7"
# Maximum boxes per frame (1-1000).
# AI_STUDIO_YOLO_MAX_DET = "300"

# ── Storage lifecycle ─────────────────────────────────────────────────────────
# All three growth paths are bounded by default. Raise a cap, or set it to 0 to
# disable pruning entirely (at the cost of unbounded disk use).
# Size at which metrics_log.jsonl rotates into .1, .2, ... (floored at 64 KiB).
# AI_STUDIO_METRICS_MAX_BYTES = "4194304"
# Rotated generations to keep. 0 truncates the log instead of rotating it.
# AI_STUDIO_METRICS_BACKUPS = "2"
# Automatic snapshots to keep, oldest pruned first. Manual snapshots are never pruned.
# AI_STUDIO_MEMORY_MAX_AUTO_SNAPSHOTS = "5000"
# Unknown-face captures to keep, oldest pruned first.
# AI_STUDIO_UNKNOWN_INCIDENT_MAX_FILES = "500"

# ── Live pacing & instance capture ───────────────────────────────────────────────────────
# Monitor-loop FPS ceiling (1-60). A lower cap trades detection latency for CPU
# headroom; the cap is a ceiling, slow machines run at whatever they keep up with.
# AI_STUDIO_FPS_CAP = "12"
# Enrollment FPS ceiling (1-60). Kept faster than monitoring on purpose.
# AI_STUDIO_ENROLL_FPS_CAP = "20"
# Seconds between auto snapshots - the instances reports and chat ground on.
# Wall-clock cadence, independent of FPS. More instances = smaller value.
# AI_STUDIO_SNAPSHOT_INTERVAL = "8.0"
